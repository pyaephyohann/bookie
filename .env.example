# PostgreSQL connection string used by Prisma (CLI migrations + runtime adapter).
# Copy this file to .env and fill in your real credentials. Never commit .env.
#
# Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookie?schema=public"

# ── Payment Configuration (B6) ──────────────────────────────────────────
# Merchant account details for payment instructions.
# In production, set real merchant information.
# In development, placeholders are used when these are missing.

BOOKIE_PAYMENT_MERCHANT_NAME="Bookie Development"
BOOKIE_PAYMENT_KPAY_PHONE="09-XXX-XXX-XXX"
BOOKIE_PAYMENT_AYA_PHONE="09-XXX-XXX-XXX"

# Optional: public URLs of QR code images for each payment method.
# If not set, a "not configured" placeholder is shown.
# BOOKIE_PAYMENT_KPAY_QR_URL="/images/qr-kpay.png"
# BOOKIE_PAYMENT_AYA_QR_URL="/images/qr-aya.png"
