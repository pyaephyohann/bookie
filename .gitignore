# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real credentials must not be committed (.env.example is the committed template)
.env
.env.*
!.env.example

# prisma generated client (created by `prisma generate`)
/generated/prisma

# admin image uploads (local dev storage — production uses an external provider)
/public/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
